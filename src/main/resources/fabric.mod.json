{
    "schemaVersion": 1,
    "id": "ikun_mod",
    "version": "${version}",
    "name": "IKun Mod",
    "description": "The IKun Mod is a Minecraft mod featuring items like the Chicken Coop and Center Parted Wig, a powerful creature Chicken Kun with unique skills, special effects, and an achievement to beat the Chicken Kun boss.",
    "authors": [
        "Jaffe2718"
    ],
    "contact": {
        "email": "qqyttwqeei@163.com",
        "issues": "https://https://github.com/Jaffe2718/ikun_mod/issues",
        "sources": "https://https://github.com/Jaffe2718/ikun_mod"
    },
    "license": "MIT",
    "icon": "assets/ikun_mod/icon.png",
    "environment": "*",
    "entrypoints": {
        "client": [
            "me.jaffe2718.ikun_mod.client.IKunModClient"
        ],
        "main": [
            "me.jaffe2718.ikun_mod.IKunMod"
        ]
    },
    "mixins": [
        "ikun_mod.mixins.json"
    ],
    "accessWidener": "ikun_mod.accesswidener",
    "depends": {
